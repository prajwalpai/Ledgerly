{
  "name": "ledgerly",
  "version": "2.0.0",
  "private": true,
  "description": "Private, local-first personal finance dashboard for macOS",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4317",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 4317",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node --import tsx scripts/check-database.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "date-fns": "4.4.0",
    "file-type": "22.0.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.5",
    "typescript": "6.0.3"
  }
}
